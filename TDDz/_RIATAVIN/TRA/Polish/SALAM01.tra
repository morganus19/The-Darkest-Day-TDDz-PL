@9  = ~Raczej odra¿aj¹ce, ale niech bêdzie.~
@10 = ~Ach, masz je... dobrze.~
@11 = ~Wyrwa³em je z cia³a umieraj¹cego stra¿nika wiêziennego.~ ~Wyrwa³am je z cia³a umieraj¹cego stra¿nika wiêziennego.~
@12 = ~Stawia³ opór, lecz spotka³a go kara.~
